# ==========================================
# Help-1 环境变量配置模板
# 复制为 .env 后填入真实值
# ==========================================

# === 数据库 ===
# MySQL root 密码（必填，Docker Compose 中用于 db 服务 + 后端连接）
DB_ROOT_PASSWORD=your_db_password_here

# === AI 审核 ===
# DeepSeek API Key（可选，不填则不启用 AI 审核）
AI_API_KEY=your_ai_api_key_here

# === 生产部署 ===
# 镜像版本标签（用于 compose.prod.yaml）
VERSION=latest
